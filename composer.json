{
    "name": "ghostwriter/phpunit-assertions",
    "description": "Additional assertions for PHPUnit",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "ghostwriter",
        "phpunit-assertions",
        "php",
        "assertions",
        "phpunit",
        "psr",
        "psr-3",
        "psr-6",
        "psr-7",
        "psr-11",
        "psr-13",
        "psr-14",
        "psr-15",
        "psr-16",
        "psr-17",
        "psr-18",
        "psr-20",
        "testing",
        "dev"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/phpunit-assertions",
    "support": {
        "issues": "https://github.com/ghostwriter/phpunit-assertions/issues",
        "source": "https://github.com/ghostwriter/phpunit-assertions",
        "rss": "https://github.com/ghostwriter/phpunit-assertions/releases.atom",
        "security": "https://github.com/ghostwriter/phpunit-assertions/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-mbstring": "*",
        "phpunit/phpunit": "^13.2.4"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "boundwize/structarmed": "^0.14.11",
        "fig/http-message-util": "^1.1.5",
        "ghostwriter/coding-standard": "dev-main",
        "ghostwriter/container": "^7.0.2",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^13.2.4",
        "psr/cache": "^3.0.0",
        "psr/clock": "^1.0.0",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^2.0.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/link": "^2.0.1",
        "psr/log": "^3.0.2",
        "psr/simple-cache": "^3.0.0",
        "symfony/var-dumper": "^8.1.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ghostwriter\\PHPUnitAssertions\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "platform-check": true,
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "thanks": {
            "name": "ghostwriter/phpunit-assertions",
            "url": "https://github.com/ghostwriter/phpunit-assertions"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "vendor/ghostwriter/coding-standard/tools/phar/infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpunit": [
            "@xdebug",
            "vendor/bin/phpunit --do-not-cache-result --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
